<Window x:Class="WindowMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:WindowMonitor.Settings"
        Title="WindowMonitor — 設定"
        Height="680" Width="470"
        MinHeight="560" MinWidth="440">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FF666666" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFCC3333" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 所有狀態訊息集中在這裡：主訊息／幀資訊／比對資訊 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- 靠右的先宣告，最後一個才吃掉剩下的寬度 -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="MatchInfoText"
                           Text="—"
                           Foreground="{StaticResource SecondaryBrush}" />
            </StatusBarItem>

            <Separator DockPanel.Dock="Right" />

            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="FrameInfoText"
                           Text="—"
                           Foreground="{StaticResource SecondaryBrush}" />
            </StatusBarItem>

            <Separator DockPanel.Dock="Right" />

            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusMessageText"
                           Text="尚未開始"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 目標視窗 -->
            <GroupBox Grid.Row="0" Header="目標視窗"
                      ToolTip="遊戲建議使用「無邊框視窗」模式，雙擊項目可直接開始擷取；擷取中要換目標請先按「停止」">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 視窗標題常常很長，截斷比長出一條水平捲軸乾淨 -->
                    <ListBox x:Name="WindowList"
                             Grid.Row="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnWindowListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RefreshButton" Content="重新整理" Click="OnRefreshClick" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 擷取控制 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="StartButton" Content="開始擷取" Click="OnStartClick" />
                <Button x:Name="StopButton" Content="停止" Click="OnStopClick"
                        Margin="8,0,0,0" IsEnabled="False" />

                <TextBlock Text="間隔" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="IntervalBox" Text="1000" Width="60"
                         VerticalContentAlignment="Center"
                         TextAlignment="Right"
                         ToolTip="擷取間隔，範圍 50 ～ 60000 ms"
                         LostFocus="OnIntervalChanged"
                         KeyDown="OnIntervalKeyDown" />
                <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>

            <TabControl Grid.Row="2">
                <TabItem Header="樣板比對">
                    <Grid Margin="4,8,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 路徑可能很長，截斷後完整值放 ToolTip（在 UpdateTemplateUi 設定） -->
                        <TextBlock x:Name="TemplateFolderText"
                                   Grid.Row="0"
                                   Text="—"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="選擇資料夾" Click="OnChooseTemplateFolderClick" MinWidth="90" />
                            <Button Content="重新載入" Click="OnReloadTemplatesClick" Margin="8,0,0,0" />
                            <Button Content="開啟資料夾" Click="OnOpenTemplateFolderClick" Margin="8,0,0,0" MinWidth="90" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="MatchEnabledCheck"
                                      Content="啟用比對"
                                      Checked="OnMatchEnabledChanged"
                                      Unchecked="OnMatchEnabledChanged" />

                            <CheckBox x:Name="LocalSearchCheck"
                                      Content="命中後只在附近搜尋"
                                      Margin="20,4,0,4"
                                      IsChecked="True"
                                      ToolTip="命中過一次後就一直在該處附近（約四分之一畫面）搜尋，大幅省下比對時間。每 10 幀仍會全圖重掃一次，目標換位置也找得回來。目標會在畫面中大範圍移動時可以關閉。"
                                      Checked="OnLocalSearchChanged"
                                      Unchecked="OnLocalSearchChanged" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="門檻" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="ThresholdSlider"
                                    Grid.Column="1"
                                    Minimum="0.50" Maximum="0.99"
                                    Value="0.80"
                                    TickFrequency="0.05"
                                    TickPlacement="BottomRight"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnThresholdChanged" />
                            <TextBlock x:Name="ThresholdText"
                                       Grid.Column="2"
                                       Text="0.80"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>

                        <!-- 唯讀清單，只是讓使用者知道載到了什麼 -->
                        <ListBox x:Name="TemplateList"
                                 Grid.Row="4"
                                 Margin="0,8,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 DisplayMemberPath="Display"
                                 Focusable="False" />
                    </Grid>
                </TabItem>

                <TabItem Header="監控視窗">
                    <StackPanel Margin="4,8,4,4">
                        <CheckBox x:Name="ClickThroughCheck"
                                  Content="點擊穿透"
                                  ToolTip="開啟後監控視窗無法拖曳或縮放，需回到這裡關閉。"
                                  Checked="OnClickThroughChanged"
                                  Unchecked="OnClickThroughChanged" />

                        <CheckBox x:Name="FadeOnHoverCheck"
                                  Content="滑鼠移入時淡出"
                                  IsChecked="True"
                                  Checked="OnFadeOnHoverChanged"
                                  Unchecked="OnFadeOnHoverChanged" />

                        <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="不透明度" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="OpacityCombo" Grid.Column="1" Width="80"
                                      SelectionChanged="OnOpacityChanged" />

                            <TextBlock Grid.Column="2" Text="移入時" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <ComboBox x:Name="HoverOpacityCombo" Grid.Column="3" Width="80"
                                      SelectionChanged="OnHoverOpacityChanged" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="重設位置" Click="OnResetPositionClick" />
                            <Button Content="重建監控視窗" Click="OnRecreateMonitorClick" Margin="8,0,0,0" MinWidth="110"
                                    ToolTip="監控視窗不見時按這個，不必重啟程式。位置與大小會保留。" />
                            <Button Content="另存目前畫面" Click="OnSaveFrameClick" Margin="8,0,0,0" MinWidth="110" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="通知">
                    <Grid Margin="4,8,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="NotifyEnabledCheck"
                                  Grid.Row="0" Grid.ColumnSpan="2"
                                  Content="啟用 Discord 通知"
                                  ToolTip="要擷取進行中、且「樣板比對」的「啟用比對」也打開，才會真的通知。"
                                  Checked="OnNotifyOptionChanged"
                                  Unchecked="OnNotifyOptionChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Webhook 網址"
                                   VerticalAlignment="Center" Margin="0,6,8,0" />
                        <TextBox x:Name="WebhookUrlBox"
                                 Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="在 Discord 的「伺服器設定 → 整合 → Webhook」建立後複製網址貼上。這串網址等同密碼，會以純文字存在 settings.json，請勿連同執行檔資料夾一起分享。"
                                 LostFocus="OnNotifyOptionChanged" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="使用者 ID"
                                   VerticalAlignment="Center" Margin="0,6,8,0" />
                        <TextBox x:Name="DiscordUserIdBox"
                                 Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                 HorizontalAlignment="Left" Width="200"
                                 VerticalContentAlignment="Center"
                                 ToolTip="要被 @ 的人。先到 Discord 的「使用者設定 → 進階」打開「開發者模式」，再對該使用者按右鍵選「複製使用者 ID」。留空則 {mention} 展開成空字串。"
                                 LostFocus="OnNotifyOptionChanged" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="訊息"
                                   VerticalAlignment="Top" Margin="0,10,8,0" />
                        <!-- AcceptsReturn 所以刻意不掛 KeyDown：Enter 要換行，不是送出 -->
                        <TextBox x:Name="MessageTemplateBox"
                                 Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{x:Static settings:AppSettings.DefaultMessageTemplate}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="48" VerticalScrollBarVisibility="Auto"
                                 LostFocus="OnNotifyOptionChanged" />

                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                   Style="{StaticResource SecondaryText}"
                                   Text="可用代碼：{template} {score} {x} {y} {time} {mention}"
                                   ToolTip="{}{template} 樣板名稱／{score} 相似度／{x} {y} 命中區域左上角的畫面座標／{time} 時間／{mention} @ 上面那位使用者。&#x0a;樣板名稱含底線或星號時 Discord 會當成 Markdown，可以在訊息裡用反引號把它包起來。" />

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="持續" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="DwellSecondsBox" Text="5" Width="52"
                                     VerticalContentAlignment="Center" TextAlignment="Right"
                                     ToolTip="樣板必須連續命中這麼久才通知，中間只要有一次取樣沒命中就重新計時。範圍 0 ～ 3600 秒。"
                                     LostFocus="OnNotifyOptionChanged"
                                     KeyDown="OnNotifyNumberKeyDown" />
                            <TextBlock Text="秒後通知" VerticalAlignment="Center" Margin="4,0,0,0" />

                            <TextBlock Text="冷卻" VerticalAlignment="Center" Margin="20,0,6,0" />
                            <TextBox x:Name="CooldownSecondsBox" Text="300" Width="52"
                                     VerticalContentAlignment="Center" TextAlignment="Right"
                                     ToolTip="一次出現只通知一則，目標留多久都不會再叫。冷卻管的是另一件事：目標消失又出現算全新的一次，會再通知，這段時間內則不會——用來擋掉目標反覆進出畫面時的洗版。範圍 1 ～ 86400 秒。"
                                     LostFocus="OnNotifyOptionChanged"
                                     KeyDown="OnNotifyNumberKeyDown" />
                            <TextBlock Text="秒" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="測試" Click="OnTestNotificationClick"
                                    ToolTip="立刻用目前欄位裡的設定送一則訊息，確認網址與 @ 對象都正確。不必先勾選「啟用 Discord 通知」。" />
                        </StackPanel>

                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource SecondaryText}"
                                   Text="Webhook 網址會以純文字存在執行檔旁的 settings.json。拿到它的人可以往那個頻道發訊息，外流時請到 Discord 刪除該 Webhook 再重建一個。" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
