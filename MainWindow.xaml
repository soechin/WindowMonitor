<Window x:Class="WindowMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowMonitor — 設定"
        Height="620" Width="470"
        MinHeight="520" MinWidth="440">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FF666666" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFCC3333" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 所有狀態訊息集中在這裡：主訊息／幀資訊／比對資訊 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- 靠右的先宣告，最後一個才吃掉剩下的寬度 -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="MatchInfoText"
                           Text="—"
                           Foreground="{StaticResource SecondaryBrush}" />
            </StatusBarItem>

            <Separator DockPanel.Dock="Right" />

            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="FrameInfoText"
                           Text="—"
                           Foreground="{StaticResource SecondaryBrush}" />
            </StatusBarItem>

            <Separator DockPanel.Dock="Right" />

            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusMessageText"
                           Text="尚未開始"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 目標視窗 -->
            <GroupBox Grid.Row="0" Header="目標視窗"
                      ToolTip="遊戲建議使用「無邊框視窗」模式，雙擊項目可直接開始擷取；擷取中要換目標請先按「停止」">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 視窗標題常常很長，截斷比長出一條水平捲軸乾淨 -->
                    <ListBox x:Name="WindowList"
                             Grid.Row="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnWindowListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RefreshButton" Content="重新整理" Click="OnRefreshClick" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 擷取控制 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="StartButton" Content="開始擷取" Click="OnStartClick" />
                <Button x:Name="StopButton" Content="停止" Click="OnStopClick"
                        Margin="8,0,0,0" IsEnabled="False" />

                <TextBlock Text="間隔" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="IntervalBox" Text="1000" Width="60"
                         VerticalContentAlignment="Center"
                         TextAlignment="Right"
                         ToolTip="擷取間隔，範圍 50 ～ 60000 ms"
                         LostFocus="OnIntervalChanged"
                         KeyDown="OnIntervalKeyDown" />
                <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>

            <TabControl Grid.Row="2">
                <TabItem Header="樣板比對">
                    <Grid Margin="4,8,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 路徑可能很長，截斷後完整值放 ToolTip（在 UpdateTemplateUi 設定） -->
                        <TextBlock x:Name="TemplateFolderText"
                                   Grid.Row="0"
                                   Text="—"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="選擇資料夾" Click="OnChooseTemplateFolderClick" MinWidth="90" />
                            <Button Content="重新載入" Click="OnReloadTemplatesClick" Margin="8,0,0,0" />
                            <Button Content="開啟資料夾" Click="OnOpenTemplateFolderClick" Margin="8,0,0,0" MinWidth="90" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="MatchEnabledCheck"
                                      Content="啟用比對"
                                      Checked="OnMatchEnabledChanged"
                                      Unchecked="OnMatchEnabledChanged" />

                            <CheckBox x:Name="LocalSearchCheck"
                                      Content="命中後只在附近搜尋"
                                      Margin="20,4,0,4"
                                      IsChecked="True"
                                      ToolTip="大幅省下比對時間。目標會在畫面中大範圍移動時可以關閉。"
                                      Checked="OnLocalSearchChanged"
                                      Unchecked="OnLocalSearchChanged" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="門檻" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="ThresholdSlider"
                                    Grid.Column="1"
                                    Minimum="0.50" Maximum="0.99"
                                    Value="0.80"
                                    TickFrequency="0.05"
                                    TickPlacement="BottomRight"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnThresholdChanged" />
                            <TextBlock x:Name="ThresholdText"
                                       Grid.Column="2"
                                       Text="0.80"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>

                        <!-- 唯讀清單，只是讓使用者知道載到了什麼 -->
                        <ListBox x:Name="TemplateList"
                                 Grid.Row="4"
                                 Margin="0,8,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 DisplayMemberPath="Display"
                                 Focusable="False" />
                    </Grid>
                </TabItem>

                <TabItem Header="監控視窗">
                    <StackPanel Margin="4,8,4,4">
                        <CheckBox x:Name="ClickThroughCheck"
                                  Content="點擊穿透"
                                  ToolTip="開啟後監控視窗無法拖曳或縮放，需回到這裡關閉。"
                                  Checked="OnClickThroughChanged"
                                  Unchecked="OnClickThroughChanged" />

                        <CheckBox x:Name="FadeOnHoverCheck"
                                  Content="滑鼠移入時淡出"
                                  IsChecked="True"
                                  Checked="OnFadeOnHoverChanged"
                                  Unchecked="OnFadeOnHoverChanged" />

                        <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="不透明度" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="OpacityCombo" Grid.Column="1" Width="80"
                                      SelectionChanged="OnOpacityChanged" />

                            <TextBlock Grid.Column="2" Text="移入時" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <ComboBox x:Name="HoverOpacityCombo" Grid.Column="3" Width="80"
                                      SelectionChanged="OnHoverOpacityChanged" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="重設位置" Click="OnResetPositionClick" />
                            <Button Content="另存目前畫面" Click="OnSaveFrameClick" Margin="8,0,0,0" MinWidth="110" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
