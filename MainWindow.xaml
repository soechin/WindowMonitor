<Window x:Class="WindowMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowMonitor — 設定"
        Height="880" Width="460"
        MinHeight="700" MinWidth="420">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 目標視窗 -->
        <GroupBox Grid.Row="0" Header="目標視窗">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- MinHeight 是必要的：下面幾個區塊都是 Auto 高，
                     少了下限的話這一列會被擠到只剩一兩行 -->
                <ListBox x:Name="WindowList"
                         Grid.Row="0"
                         MinHeight="150"
                         DisplayMemberPath="Display"
                         MouseDoubleClick="OnWindowListDoubleClick" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="RefreshButton" Content="重新整理" Click="OnRefreshClick" />
                    <TextBlock x:Name="HintText"
                               Text="遊戲建議使用「無邊框視窗」模式"
                               Foreground="#FF666666"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 擷取控制 -->
        <GroupBox Grid.Row="1" Header="擷取">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="開始擷取" Click="OnStartClick" />
                    <Button x:Name="StopButton" Content="停止" Click="OnStopClick"
                            Margin="8,0,0,0" IsEnabled="False" />

                    <TextBlock Text="間隔" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox x:Name="IntervalBox" Text="1000" Width="60"
                             VerticalContentAlignment="Center"
                             TextAlignment="Right"
                             LostFocus="OnIntervalChanged"
                             KeyDown="OnIntervalKeyDown" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Text="尚未開始"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FrameInfoText"
                           Text="—"
                           Foreground="#FF666666"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- 樣板比對 -->
        <GroupBox Grid.Row="2" Header="樣板比對">
            <StackPanel>
                <TextBlock x:Name="TemplateFolderText"
                           Text="—"
                           Foreground="#FF666666"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="選擇資料夾" Click="OnChooseTemplateFolderClick" MinWidth="90" />
                    <Button Content="重新載入" Click="OnReloadTemplatesClick" Margin="8,0,0,0" />
                    <Button Content="開啟資料夾" Click="OnOpenTemplateFolderClick" Margin="8,0,0,0" MinWidth="90" />
                </StackPanel>

                <CheckBox x:Name="MatchEnabledCheck"
                          Content="啟用比對"
                          Margin="0,8,0,4"
                          Checked="OnMatchEnabledChanged"
                          Unchecked="OnMatchEnabledChanged" />

                <CheckBox x:Name="LocalSearchCheck"
                          Content="命中後只在附近搜尋"
                          IsChecked="True"
                          Checked="OnLocalSearchChanged"
                          Unchecked="OnLocalSearchChanged" />
                <TextBlock Text="大幅省下比對時間。目標會在畫面中大範圍移動時可以關閉。"
                           Foreground="#FF666666"
                           Margin="20,0,0,6"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="門檻" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="ThresholdSlider"
                            Width="200"
                            Minimum="0.50" Maximum="0.99"
                            Value="0.80"
                            TickFrequency="0.05"
                            TickPlacement="BottomRight"
                            VerticalAlignment="Center"
                            ValueChanged="OnThresholdChanged" />
                    <TextBlock x:Name="ThresholdText"
                               Text="0.80"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <!-- 唯讀清單，只是讓使用者知道載到了什麼 -->
                <ListBox x:Name="TemplateList"
                         Height="76"
                         Margin="0,8,0,0"
                         DisplayMemberPath="Display"
                         Focusable="False" />

                <TextBlock x:Name="TemplateErrorText"
                           Foreground="#FFCC3333"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <TextBlock x:Name="MatchStatusText"
                           Text="—"
                           Foreground="#FF666666"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- 監控視窗 -->
        <GroupBox Grid.Row="3" Header="監控視窗">
            <StackPanel>
                <CheckBox x:Name="ClickThroughCheck"
                          Content="點擊穿透"
                          Checked="OnClickThroughChanged"
                          Unchecked="OnClickThroughChanged" />
                <TextBlock Text="開啟後監控視窗無法拖曳或縮放，需回到這裡關閉。"
                           Foreground="#FF666666"
                           Margin="20,0,0,6"
                           TextWrapping="Wrap" />

                <CheckBox x:Name="FadeOnHoverCheck"
                          Content="滑鼠移入時淡出"
                          IsChecked="True"
                          Checked="OnFadeOnHoverChanged"
                          Unchecked="OnFadeOnHoverChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="OpacityCombo" Width="80"
                              SelectionChanged="OnOpacityChanged" />

                    <TextBlock Text="移入時" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox x:Name="HoverOpacityCombo" Width="80"
                              SelectionChanged="OnHoverOpacityChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="重設位置" Click="OnResetPositionClick" />
                    <Button Content="另存目前畫面" Click="OnSaveFrameClick" Margin="8,0,0,0" MinWidth="110" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4"
                   x:Name="FooterText"
                   Foreground="#FF666666"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
